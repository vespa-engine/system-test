# Copyright Vespa.ai. All rights reserved.

schema paragraph {
  document paragraph {

    field id type long {
      indexing: attribute | summary
    }

    field embedding type tensor<float>(x[768]) {
      indexing: attribute | index | summary
      attribute {
        distance-metric: dotproduct
        quantization {
          bits: %{QUANTIZATION_BITS} # Substituted by test
        }
      }
      index {
        hnsw {
          max-links-per-node: 48
          neighbors-to-explore-at-insert: 200
        }
      }
    }

  }

  field embedding_f32 type tensor<float>(x[768]) {
    # Since this forking happens at document processing time, the input will be the
    # full precision tensor data and not (de-)quantized tensor data.
    indexing: input embedding | attribute | summary
    attribute {
      distance-metric: dotproduct
    }
  }

  rank-profile default {
    inputs {
      query(paragraph) tensor<float>(x[768])
    }
    first-phase {
      expression: rawScore(embedding)
    }
  }

  rank-profile full_precision_exact_match {
    inputs {
      query(paragraph) tensor<float>(x[768])
    }
    first-phase {
      expression: rawScore(embedding_f32)
    }
  }

  document-summary minimal {
    summary id {}
  }

}
