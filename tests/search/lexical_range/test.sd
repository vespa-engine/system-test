# Copyright Vespa.ai. All rights reserved.
schema test {
  document test {
     field id type int {
         indexing: attribute | summary
         attribute: fast-search
     }

     # String fields
     field string_single type string {
         indexing: attribute | summary
     }
     field string_single_fast type string {
         indexing: attribute | summary
         attribute: fast-search
     }
     field string_multi type array<string> {
         indexing: attribute | summary
     }
     field string_multi_fast type array<string> {
         indexing: attribute | summary
         attribute: fast-search
     }

     # String fields with cased matching
     field string_single_cased type string {
         indexing: attribute | summary
         match: cased
     }
     field string_single_fast_cased type string {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
     }
     field string_multi_cased type array<string> {
         indexing: attribute | summary
         match: cased
     }
     field string_multi_fast_cased type array<string> {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
     }
  }
}
