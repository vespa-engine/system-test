# Copyright Vespa.ai. All rights reserved.
schema test {
  document test {
     field id type int {
         indexing: attribute | summary
         attribute: fast-search
     }

     # String fields
     field string_single type string {
         indexing: attribute | summary
     }
     field string_single_fast_btree type string {
         indexing: attribute | summary
         attribute: fast-search
         dictionary {
           btree
         }
     }
     field string_multi type array<string> {
         indexing: attribute | summary
     }
     field string_multi_fast_btree type array<string> {
         indexing: attribute | summary
         attribute: fast-search
         dictionary {
           btree
         }
     }

     # String fields with cased matching
     field string_single_cased type string {
         indexing: attribute | summary
         match: cased
     }
     field string_single_fast_cased_btree type string {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
         dictionary {
           btree
           cased
         }
     }
     field string_single_fast_cased_hash type string {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
         dictionary {
           hash
           cased
         }
     }
     field string_single_fast_cased_btree_hash type string {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
         dictionary {
           btree
           hash
           cased
         }
     }
     field string_multi_cased type array<string> {
         indexing: attribute | summary
         match: cased
     }
     field string_multi_fast_cased_btree type array<string> {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
         dictionary {
           btree
           cased
         }
     }
     field string_multi_fast_cased_hash type array<string> {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
         dictionary {
           hash
           cased
         }
     }
     field string_multi_fast_cased_btree_hash type array<string> {
         indexing: attribute | summary
         attribute: fast-search
         match: cased
         dictionary {
           btree
           hash
           cased
         }
     }
  }
  rank-profile my-rank-profile {
    match-features {
      matches(string_single)
      matches(string_single_fast_btree)
      matches(string_multi)
      matches(string_multi_fast_btree)
      matches(string_single_cased)
      matches(string_single_fast_cased_btree)
      matches(string_single_fast_cased_hash)
      matches(string_single_fast_cased_btree_hash)
      matches(string_multi_cased)
      matches(string_multi_fast_cased_btree)
      matches(string_multi_fast_cased_hash)
      matches(string_multi_fast_cased_btree_hash)
    }
  }
}
