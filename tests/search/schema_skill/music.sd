schema music {

    explanation: Music albums with their artists

    document music {
        field album type string {
            indexing: index | summary
            explanation: The title of the album
        }
        field artist type string {
            indexing: attribute | summary
            explanation: The name of the artist who made the album
        }
    }

    rank-profile by_album {
        explanation: Ranks albums by how well the query matches the album title
        first-phase {
            expression: nativeRank(album)
        }
    }

}
