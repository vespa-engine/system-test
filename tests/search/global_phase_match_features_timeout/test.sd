schema test {
    document test {
        field id type int {
            indexing: attribute | summary
        }
        field tags type tensor<float>(tag{}) {
            indexing: attribute | summary
        }
    }

    rank-profile slow_match_features {
        first-phase {
            expression: attribute(id)
        }

        # Sleeps 50 ms each time it is calculated, so extracting the
        # match features for many hits takes longer than the query timeout.
        function slow() {
            expression: debugWait(0.05, 0)
        }

        match-features {
            slow
            attribute(tags)
        }

        # Uses the tensor match feature attribute(tags) in the container.
        global-phase {
            rerank-count: 300
            expression: sum(attribute(tags))
        }
    }
}
