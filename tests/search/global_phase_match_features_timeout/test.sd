schema test {
    document test {
        field id type int {
            indexing: attribute | summary
        }
        field tags type tensor<float>(tag{}) {
            indexing: attribute | summary
        }
    }

    rank-profile slow_match_features {
        first-phase {
            expression: attribute(id)
        }

        # Sleeps 50 ms each time it is calculated on the content node with
        # distribution key 0, so extracting the match features for many hits
        # there takes longer than the query timeout. Other content nodes do not
        # sleep. fmod(globalSequence, 65536) is 0 only on distribution key 0.
        function slow() {
            expression: if(fmod(globalSequence, 65536) == 0, debugWait(0.05, 0), 0)
        }

        match-features {
            slow
            attribute(tags)
        }

        # Uses the tensor match feature attribute(tags) in the container.
        global-phase {
            rerank-count: 600
            expression: sum(attribute(tags))
        }
    }
}
