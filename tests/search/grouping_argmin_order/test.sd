schema test {
  document test {
    field a type string {
      indexing: attribute | summary
    }
    field n type int {
      indexing: attribute | summary
    }
    field d type double {
      indexing: attribute | summary
    }
    field s type string {
      indexing: attribute | summary
    }
  }
}
