schema test {
  document test {
    field a type string {
      indexing: attribute | summary
    }
    field n type int {
      indexing: attribute | summary
    }
    field d type double {
      indexing: attribute | summary
    }
    field s type string {
      indexing: attribute | summary
    }
  }
  # Distinct group relevance (max d per group) so that results without order() have a deterministic group order.
  rank-profile default {
    first-phase {
      expression: attribute(d)
    }
  }
}
