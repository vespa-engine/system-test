# A 'struct-field' selection for a map which names the key but nothing from the value; must fail
# validation.
schema structsel_mapnovalue {

  struct pair {
    field p1 type string {}
    field p2 type int {}
  }

  document structsel_mapnovalue {

    field title type string {
      indexing: index | summary
    }

    field smap type map<string, pair> {
      indexing: summary
      struct-field key {
        indexing: attribute
      }
      struct-field value.p1 {
        indexing: attribute
      }
      struct-field value.p2 {
        indexing: attribute
      }
    }
  }

  fieldset default {
    fields: title
  }

  document-summary badsum {
    summary smap {
      struct-field: key
    }
  }
}
