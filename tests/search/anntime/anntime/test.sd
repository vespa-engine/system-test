schema test {
  document test {
    field id type int {
      indexing: summary | attribute
    }
    field tensor_field type tensor<float>(x[2048]) {
      indexing: summary | attribute | index
      index {
        hnsw {
          # We do not care about the quality of the search results. We just want to make the search take a long time.
          # Be careful not to choose the values too low as this might result in small isolated components in the graph,
          # which then can make the search terminate immediately.
          max-links-per-node: 16
          neighbors-to-explore-at-insert: 32
        }
      }
    }
  }
  rank-profile default {
    first-phase {
      expression: closeness(field,tensor_field)
    }
  }
  document-summary minimal {
    summary id {}
  }
}
