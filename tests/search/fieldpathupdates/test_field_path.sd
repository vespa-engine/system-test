schema test_field_path {
    document test_field_path {
        field docid type long {
            indexing: attribute | summary
        }

        field attr_int type array<int> {
            indexing: attribute | summary
        }

        field doc_int type array<int> {
            indexing: summary
        }

        field attr_str type array<string> {
            indexing: attribute | summary
        }

        field doc_str type array<string> {
            indexing: summary
        }

        field attr_map type map<string, int> {
            indexing: summary
            struct-field key {
                indexing: attribute
            }
            struct-field value {
                indexing: attribute
            }
        }

        field doc_map type map<string, int> {
            indexing: summary
        }

        field idx_str type array<string> {
            indexing: index | summary
        }

        field idx_attr_str type array<string> {
            indexing: index | attribute | summary
        }
    }
}
